; Engine configuration file.
; Hand-written rather than generated by the editor: every setting that matters is
; visible in the diff, and the project runs from a fresh clone with no import step.

config_version=5

[application]

config/name="Voxel Q*bert"
config/description="A voxel remake of Q*bert's pyramid: hop the cubes, dodge the snakes, ride the discs."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

; The Compatibility (OpenGL) renderer is used deliberately: the game is a handful of
; unshaded-ish cubes, and Compatibility runs on integrated GPUs, older drivers and
; software rasterisers that Vulkan decks refuse.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.06, 1)
anti_aliasing/quality/msaa_3d=2

[input_devices]

pointing/emulate_touch_from_mouse=false
