; Engine configuration file.
; Hand-written rather than generated by the editor: every setting that matters is
; visible in the diff, and the project runs from a fresh clone with no import step.

config_version=5

[application]

config/name="Bullfrog Blox"
config/description="A voxel arcade hopper: paint the pyramid, dodge the snakes, ride the discs."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

; Forward+ is required for the look: real-time shadows, screen-space ambient
; occlusion and glow are what turn flat cubes into a voxel diorama. The game is
; still tiny, so even integrated GPUs have headroom.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.06, 1)
anti_aliasing/quality/msaa_3d=2
; 4096 shadow map: the only shadows in the game are the ones the pyramid and the
; cast drop onto the ground plate, and at 2048 they dither visibly.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3

[input_devices]

pointing/emulate_touch_from_mouse=false
